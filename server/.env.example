# Keep this file on the server only. Never add an API key to client/src or VITE_* variables.
PORT=8787

# Google Gemini API key. Create one for free at https://aistudio.google.com/apikey
# Leave the placeholder as-is to run in demo mode (simple keyword checks, no AI).
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Any Gemini model that supports generateContent. See https://ai.google.dev/gemini-api/docs/models
# Examples: gemini-3.8-flash (default), gemini-3.5-flash-lite (cheaper/faster)
GEMINI_MODEL=gemini-3.8-flash

# Backup model used automatically if the main model is overloaded (HTTP 503/429).
# Set to "off" to disable the backup.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Request timeout in milliseconds (5000-90000).
GEMINI_TIMEOUT_MS=45000
